{
  "discovery_format": "huffman-protocol-discovery/0.2",
  "project": {
    "id": "org.huffman.protocol",
    "name": "Huffman Protocol",
    "repository": "https://github.com/HuffmanMainNode/Huffman-Protocol",
    "maturity": "experimental"
  },
  "registry": {
    "index": "registry/index.json",
    "schema": "src/huffman_protocol/schemas/registry.schema.json"
  },
  "manifest_schema": "src/huffman_protocol/schemas/manifest.schema.json",
  "agent_instructions": "AGENTS.md",
  "implemented_capabilities": [
    "offline-manifest-schema-validation",
    "offline-registry-schema-validation",
    "registry-reference-existence-checks",
    "registry-manifest-identifier-consistency-checks",
    "registry-path-traversal-rejection",
    "offline-evidence-package-schema-validation",
    "offline-evidence-artifact-sha256-verification",
    "evidence-artifact-path-traversal-and-symlink-rejection",
    "local-python-cli",
    "source-and-wheel-distribution-build",
    "offline-evidence-package-example",
    "duplicate-json-object-key-rejection",
    "bounded-evidence-manifest-and-artifact-verification",
    "evidence-manifest-symlink-rejection",
    "evidence-package-collection-size-limits"
  ],
  "not_yet_implemented": [
    "conformance-test-execution",
    "cross-implementation-differential-testing",
    "cryptographic-evidence-signing",
    "independent-evidence-verifier",
    "federated-discovery",
    "mcp-adapter",
    "a2a-adapter",
    "live-network-protocol-translation",
    "runtime-transport-proxy",
    "remote-agent-coordination",
    "automatic-registry-crawling"
  ],
  "execution_policy": {
    "default_access": "read-only",
    "network_required_for_validation": false,
    "remote_code_execution_supported": false,
    "agent_pull_requests_require_maintainer_review": true
  },
  "package": {
    "distribution": "huffman-protocol",
    "python_requires": ">=3.11",
    "install_from_checkout": "python -m pip install .",
    "cli_entrypoint": "huffman-protocol",
    "runtime_host_required": false,
    "validation_network_required": false,
    "commands": [
      "huffman-protocol validate-manifest PATH",
      "huffman-protocol validate-registry PATH",
      "huffman-protocol verify-evidence DIRECTORY"
    ],
    "example_evidence_package": "examples/evidence-package"
  },
  "specifications": {
    "manifest": "specifications/manifest/README.md",
    "conformance": "specifications/conformance/README.md",
    "evidence": "specifications/evidence/README.md",
    "versioning": "specifications/VERSIONING.md"
  },
  "runtime": {
    "mode": "local-library-and-cli",
    "server_required": false,
    "github_required_at_runtime": false,
    "validation_requires_network": false,
    "opens_network_sockets": false,
    "executes_third_party_code": false,
    "agent_state_storage": "caller-managed-local-state"
  }
}
