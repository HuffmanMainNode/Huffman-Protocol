{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huffman-protocol:schema:conformance-vector:0.1.0",
  "title": "Huffman Protocol Conformance Vector",
  "description": "Declarative test vector metadata. This schema does not authorize or execute test code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_version",
    "id",
    "target",
    "input",
    "assertions",
    "preconditions",
    "permitted_side_effects",
    "timeout_seconds",
    "resource_limits",
    "determinism",
    "expected_outcome",
    "safety_classification"
  ],
  "properties": {
    "vector_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "version"
      ],
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "implementation": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "input": {
      "type": "object"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "operator"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "operator": {
            "enum": [
              "exists",
              "equals",
              "not-equals",
              "contains",
              "type-is"
            ]
          },
          "expected": {}
        }
      }
    },
    "preconditions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "permitted_side_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "temporary-files",
          "local-read",
          "local-write",
          "loopback-network",
          "external-network"
        ]
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_mb",
        "cpu_seconds",
        "max_output_bytes"
      ],
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "cpu_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "determinism": {
      "enum": [
        "deterministic",
        "seeded",
        "nondeterministic"
      ]
    },
    "expected_outcome": {
      "enum": [
        "pass",
        "fail",
        "error",
        "skipped",
        "not-applicable"
      ]
    },
    "safety_classification": {
      "enum": [
        "safe-local",
        "isolated-execution-required",
        "manual-review-required"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
