{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huffman-protocol:schema:evidence:0.1.0",
  "title": "Huffman Protocol Evidence Package",
  "description": "Offline-verifiable evidence metadata and SHA-256 artifact references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_version",
    "id",
    "created_at",
    "subject",
    "test_suite",
    "results",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "evidence_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "commit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "test_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "maxLength": 160
        },
        "platform": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "outcome"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "error",
              "skipped",
              "not-applicable"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "maxItems": 4096
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "maxLength": 120
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxItems": 256
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 128
    }
  }
}
