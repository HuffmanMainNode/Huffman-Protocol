{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huffman-protocol:schema:manifest:0.1.0",
  "title": "Huffman Protocol Manifest",
  "description": "Machine-readable metadata for a protocol specification, implementation, adapter, or supporting tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "name",
    "relationship",
    "status",
    "summary",
    "source",
    "capabilities",
    "limitations"
  ],
  "properties": {
    "manifest_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "relationship": {
      "enum": [
        "specification",
        "implementation",
        "adapter",
        "supporting-tool"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "experimental",
        "active",
        "stable",
        "deprecated",
        "retired"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "protocol_version": {
      "type": "string",
      "maxLength": 80
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "release": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "license": {
      "type": "string",
      "maxLength": 120
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "specification": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "constraint"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "constraint": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-evaluated",
            "declared",
            "implemented",
            "tested",
            "independently-verified"
          ]
        },
        "test_suite": {
          "type": "string",
          "maxLength": 300
        },
        "last_evaluated": {
          "type": "string",
          "format": "date"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "tested",
                  "independently-verified"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "test_suite",
              "last_evaluated",
              "evidence"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issues": {
          "type": "string",
          "format": "uri"
        },
        "documentation": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
